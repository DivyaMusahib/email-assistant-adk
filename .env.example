# ---- Gemini (the LLM brain) ----
# Get it free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste_your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: override the model (default is set in email_agent/config.py)
# Default is gemini-3.5-flash-lite. Stronger alternative: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Microsoft Graph (the mailbox) ----
# "Application (client) ID" from your Entra app registration (see README)
MS_CLIENT_ID=paste_your_application_client_id_here
# "common"    = work/school AND personal accounts (outlook.com, hotmail.com)  <- default
# "consumers" = personal Microsoft accounts only
# "organizations" = work/school only, or your Directory (tenant) ID
MS_TENANT_ID=common

# Optional: IANA timezone used to show dates and to understand "yesterday"
# Defaults to your computer's local timezone.
# USER_TIMEZONE=Asia/Kolkata
